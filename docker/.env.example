# Local Compose template only. Replace all secret placeholders before startup.
POSTGRES_DB=finance_os
POSTGRES_USER=finance_os
POSTGRES_PASSWORD=change-me-to-a-local-postgres-password
JWT_SECRET=change-me-to-a-local-jwt-secret-with-at-least-32-characters
MIGRATION_PREVIEW_SECRET=change-me-to-a-separate-preview-secret-at-least-32-characters
FINANCE_IMPORT_CONFIRM_TOKEN_SECRET=change-me-to-a-local-import-confirm-secret-at-least-32-characters
MARKET_DATA_ENABLED=false
MARKET_DATA_API_KEY=
MARKET_DATA_USER_REQUEST_LIMIT_PER_MINUTE=10
MARKET_DATA_PROVIDER_REQUEST_LIMIT_PER_MINUTE=8
FRONTEND_PORT=8088
# Non-secret identities: generate three UUIDs once per deployment, preserve them with the persistent volume.
# Replace these examples before first provisioning; never regenerate them on normal restart.
FINANCE_IMPORT_STORAGE_DEPLOYMENT_ID=277bab44-785c-46d8-a3bc-b832b6ddb1f6
FINANCE_IMPORT_STORAGE_RAW_ID=0a1b8d9d-55ec-48d7-a0dd-0207dcc57bea
FINANCE_IMPORT_STORAGE_PLAN_ID=1330daf0-4b62-4e0e-ad7a-b0964d296a60
